# Google Calendar Integration Environment Variables
# Copy these to your main .env file and fill in the actual values

# Google OAuth 2.0 Credentials
# Get these from: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Calendar Encryption Key (for securing OAuth tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALENDAR_ENCRYPTION_KEY=your_base64_encryption_key_here

# Application URL (must match your OAuth redirect URI)
NEXT_PUBLIC_APP_URL=http://localhost:9999

# Optional: Calendar-specific settings
CALENDAR_DEFAULT_TIMEZONE=America/New_York
CALENDAR_BUFFER_TIME_MINUTES=5
CALENDAR_SYNC_BATCH_SIZE=50

# Google Calendar API Quotas (for monitoring)
GOOGLE_CALENDAR_DAILY_QUOTA=1000000
GOOGLE_CALENDAR_RATE_LIMIT_PER_MINUTE=100

# ============================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================

# 1. Create Google Cloud Project
#    - Go to https://console.cloud.google.com/
#    - Create new project or select existing one
#    - Enable Google Calendar API

# 2. Create OAuth 2.0 Credentials
#    - Go to APIs & Services → Credentials
#    - Click "Create Credentials" → "OAuth 2.0 Client IDs"
#    - Application type: Web application
#    - Authorized redirect URIs: https://yourdomain.com/api/calendar/google/callback

# 3. Generate Encryption Key
#    - Run: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#    - Keep this secret secure and don't change in production

# 4. Database Migration
#    - Run: npm run db:migrate
#    - Or apply: database/migrations/008_add_calendar_integrations.sql

# 5. Test Configuration
#    - Start your application
#    - Check logs for "✅ Google Calendar service initialized successfully"
#    - Test OAuth flow at /dashboard/calendar-settings

# ============================================
# SECURITY NOTES
# ============================================

# - Keep GOOGLE_CLIENT_SECRET secure (server-side only)
# - CALENDAR_ENCRYPTION_KEY must be 32 bytes base64 encoded
# - Use HTTPS in production (required by Google OAuth)
# - Regularly rotate the encryption key (with migration plan)
# - Monitor API usage to avoid quota exhaustion

# ============================================
# TROUBLESHOOTING
# ============================================

# Common Issues:
# - "redirect_uri_mismatch": Check OAuth redirect URI in Google Console
# - "invalid_client": Check GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
# - "Calendar service not initialized": Check environment variables
# - "Encryption error": Regenerate CALENDAR_ENCRYPTION_KEY