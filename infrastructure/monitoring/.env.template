# Environment Configuration Template for 6FB AI Agent System Monitoring
# Copy this file to .env and configure with your specific values

# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================
ENVIRONMENT=production
DATACENTER=primary
APP_VERSION=latest

# =============================================================================
# EXTERNAL URLS
# =============================================================================
PROMETHEUS_EXTERNAL_URL=http://prometheus:9090
GRAFANA_URL=http://localhost:3001
ALERTMANAGER_EXTERNAL_URL=http://alertmanager:9093

# =============================================================================
# GRAFANA CONFIGURATION
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_DOMAIN=localhost

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sixfb_agent_system?sslmode=disable
POSTGRES_PASSWORD=postgres

# Redis configuration
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# =============================================================================
# SMTP CONFIGURATION FOR ALERTS
# =============================================================================
# Enable SMTP for Grafana
SMTP_ENABLED=false

# SMTP server settings
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_FROM=alerts@6fb.ai
SMTP_USERNAME=alerts@6fb.ai
SMTP_PASSWORD=your_app_password

# =============================================================================
# ALERT DESTINATIONS
# =============================================================================
# Default alert email
DEFAULT_EMAIL=admin@6fb.ai

# Critical alerts and on-call
ONCALL_EMAIL=oncall@6fb.ai
LEAD_EMAIL=tech-lead@6fb.ai

# Business stakeholders
BUSINESS_EMAIL=business@6fb.ai
CEO_EMAIL=ceo@6fb.ai
CTO_EMAIL=cto@6fb.ai
PRODUCT_EMAIL=product@6fb.ai

# Technical teams
SRE_EMAIL=sre@6fb.ai
OPS_EMAIL=ops@6fb.ai
DBA_EMAIL=dba@6fb.ai
INFRA_EMAIL=infrastructure@6fb.ai
K8S_EMAIL=k8s-ops@6fb.ai
MONITORING_EMAIL=monitoring@6fb.ai

# Specialized teams
SECURITY_EMAIL=security@6fb.ai
CISO_EMAIL=ciso@6fb.ai
AI_TEAM_EMAIL=ai-team@6fb.ai
FINANCE_EMAIL=finance@6fb.ai
COMPLIANCE_EMAIL=compliance@6fb.ai

# Time-based alerts
BUSINESS_HOURS_EMAIL=team@6fb.ai
AFTER_HOURS_EMAIL=oncall@6fb.ai

# =============================================================================
# THIRD-PARTY INTEGRATIONS (OPTIONAL)
# =============================================================================
# Slack integration
SLACK_WEBHOOK_URL=
SLACK_CRITICAL_WEBHOOK_URL=

# PagerDuty integration
PAGERDUTY_SERVICE_KEY=

# API tokens
API_HEALTH_TOKEN=

# =============================================================================
# MONITORING RETENTION & PERFORMANCE
# =============================================================================
# Prometheus retention
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=50GB

# Query limits
PROMETHEUS_MAX_CONCURRENCY=20
PROMETHEUS_QUERY_TIMEOUT=5m

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# TLS/SSL (if using HTTPS)
TLS_CERT_FILE=/etc/ssl/certs/monitoring.crt
TLS_KEY_FILE=/etc/ssl/private/monitoring.key
TLS_CA_FILE=/etc/ssl/certs/ca.crt

# =============================================================================
# DEVELOPMENT / TESTING
# =============================================================================
# Set to true for development environment
DEV_MODE=false

# Enable debug logging
DEBUG_LOGGING=false

# Mock external services (for testing)
MOCK_EXTERNAL_SERVICES=false

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Backup storage location
BACKUP_PATH=/backups/monitoring

# Backup retention
BACKUP_RETENTION_DAYS=30

# S3 backup configuration (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BACKUP_BUCKET=6fb-monitoring-backups

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================
# Remote write configuration (for long-term storage)
REMOTE_WRITE_URL=
REMOTE_WRITE_USERNAME=
REMOTE_WRITE_PASSWORD=

# Distributed tracing (Jaeger)
JAEGER_ENDPOINT=jaeger:14268/api/traces

# Log aggregation (Loki)
LOKI_URL=loki:3100

# =============================================================================
# RESOURCE LIMITS (for production tuning)
# =============================================================================
# Prometheus
PROMETHEUS_MEMORY_LIMIT=4G
PROMETHEUS_CPU_LIMIT=2

# Grafana
GRAFANA_MEMORY_LIMIT=1G
GRAFANA_CPU_LIMIT=1

# AlertManager
ALERTMANAGER_MEMORY_LIMIT=512M
ALERTMANAGER_CPU_LIMIT=0.5