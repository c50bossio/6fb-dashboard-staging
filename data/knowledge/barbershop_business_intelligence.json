{
  "title": "Barbershop Business Intelligence and Analytics Framework",
  "knowledge_type": "business_strategy",
  "source": "business_intelligence_system",
  "sections": [
    {
      "title": "Revenue Optimization Analytics",
      "content": "Comprehensive analytics framework for maximizing barbershop revenue through data-driven decision making.",
      "analytics_categories": [
        {
          "category": "Pricing Analysis",
          "metrics": [
            {
              "metric": "Price Elasticity",
              "description": "Measure client sensitivity to price changes",
              "calculation": "% Change in Demand / % Change in Price",
              "target": "< -0.5 for premium positioning"
            },
            {
              "metric": "Revenue Per Service Type",
              "description": "Revenue contribution by service category",
              "calculation": "Total Revenue / Service Type",
              "insights": "Identify highest profit services"
            },
            {
              "metric": "Average Ticket Value",
              "description": "Average spending per client visit",
              "calculation": "Total Revenue / Number of Appointments",
              "target": "$75+ for six-figure business"
            }
          ]
        },
        {
          "category": "Client Lifetime Value",
          "metrics": [
            {
              "metric": "CLV Calculation",
              "description": "Total value of client relationship",
              "calculation": "(Average Purchase × Purchase Frequency × Retention Period) - Acquisition Cost",
              "target": "$2000+ for premium clients"
            },
            {
              "metric": "Retention Rate",
              "description": "Percentage of clients returning",
              "calculation": "(Returning Clients / Total Clients) × 100",
              "target": "80%+ for sustainable growth"
            },
            {
              "metric": "Frequency of Visits",
              "description": "How often clients return",
              "calculation": "Total Visits / Unique Clients",
              "target": "Every 3-4 weeks"
            }
          ]
        }
      ]
    },
    {
      "title": "Operational Efficiency Metrics",
      "content": "Key performance indicators for optimizing day-to-day barbershop operations.",
      "efficiency_areas": [
        {
          "area": "Time Management",
          "kpis": [
            {
              "name": "Service Time Optimization",
              "description": "Average time per service type",
              "benchmarks": {
                "basic_cut": "30-45 minutes",
                "premium_cut": "45-60 minutes",
                "full_service": "60-90 minutes"
              }
            },
            {
              "name": "Utilization Rate",
              "description": "Percentage of available time booked",
              "calculation": "Booked Hours / Available Hours × 100",
              "target": "85-95% during peak times"
            },
            {
              "name": "No-Show Rate",
              "description": "Percentage of missed appointments",
              "calculation": "Missed Appointments / Total Scheduled × 100",
              "target": "Less than 5%"
            }
          ]
        },
        {
          "area": "Resource Utilization",
          "kpis": [
            {
              "name": "Staff Productivity",
              "description": "Revenue generated per staff member",
              "calculation": "Total Revenue / Number of Staff",
              "target": "$150K+ per barber annually"
            },
            {
              "name": "Equipment ROI",
              "description": "Return on equipment investment",
              "calculation": "(Revenue Increase - Equipment Cost) / Equipment Cost",
              "target": "200%+ within 2 years"
            }
          ]
        }
      ]
    },
