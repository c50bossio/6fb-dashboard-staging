    {
      "title": "Core Business Philosophy",
      "content": "The Six Figure Barber methodology is built on transforming traditional barbershops into premium, profitable businesses through strategic pricing, exceptional service delivery, and operational excellence. The foundation is treating barbering as a skilled profession deserving of premium compensation.",
      "key_concepts": [
        "Premium positioning over commodity pricing",
        "Service excellence as competitive advantage",
        "Systems-based operations for consistency",
        "Client experience focus over transaction mentality",
        "Continuous skill development and expertise building"
      ]
    },
    {
      "title": "Strategic Pricing Framework",
      "content": "Implement value-based pricing that reflects skill level, service quality, and client experience. Move away from competitive pricing to premium positioning through service differentiation.",
      "pricing_strategies": [
        {
          "level": "Foundation",
          "price_range": "$35-50",
          "requirements": "Basic barbering skills, clean shop, professional appearance",
          "services": "Standard cuts, basic styling"
        },
        {
          "level": "Professional",
          "price_range": "$50-75",
          "requirements": "Advanced techniques, consultation skills, brand development",
          "services": "Premium cuts, styling, grooming consultation"
        },
        {
          "level": "Master",
          "price_range": "$75-125+",
          "requirements": "Expertise, unique specializations, luxury experience",
          "services": "Signature services, VIP treatment, full grooming suites"
        }
      ],
