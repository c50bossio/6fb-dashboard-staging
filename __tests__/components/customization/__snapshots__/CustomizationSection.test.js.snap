    data-testid="customization-section-test-section"
  >
    <button
      aria-controls="section-test-section"
      aria-expanded="false"
      class="w-full px-4 sm:px-6 py-4 sm:py-5 bg-white transition-all duration-200 text-left hover:bg-gray-50 scale-100 active:scale-[0.97]"
      data-testid="section-toggle-test-section"
    >
      <div
        class="flex items-center justify-between"
      >
        <div
          class="flex items-center space-x-3 sm:space-x-4 flex-1 min-w-0"
        >
          <div
            class="relative p-2 sm:p-2.5 rounded-xl transition-all duration-200 bg-blue-50 border-blue-200 text-blue-800 "
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 sm:h-6 sm:w-6 transition-transform duration-200"
              data-slot="icon"
              data-testid="section-icon"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </div>
          <div
            class="flex-1 min-w-0"
          >
            <div
              class="flex items-center space-x-2 flex-wrap"
            >
              <h3
                class="text-base sm:text-lg font-semibold text-gray-900 truncate"
                data-testid="section-title"
              >
                Test Section
              </h3>
            </div>
            <p
              class="text-sm text-gray-600 mt-1 line-clamp-2 sm:line-clamp-1"
              data-testid="section-description"
            >
              Test description
            </p>
          </div>
        </div>
      </div>
    </button>
    <div
      class="overflow-hidden transition-all duration-300 ease-in-out"
      data-testid="section-content"
      id="section-test-section"
      style="max-height: 0px;"
    >
      <div
        class="border-t border-gray-200 bg-gradient-to-br from-gray-50 to-white p-4 sm:p-6"
      >
        Test Content
      </div>
    </div>
  </div>
</div>
`;

